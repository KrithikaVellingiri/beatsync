PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/beatsync"
JWT_SECRET="your-super-secret-jwt-key"

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

# Google OAuth Client IDs (replace with your actual client IDs from Google Cloud Console)
GOOGLE_CLIENT_ID_WEB=YOUR_GOOGLE_CLIENT_ID_WEB_HERE
GOOGLE_CLIENT_ID_ANDROID=YOUR_GOOGLE_CLIENT_ID_ANDROID_HERE
GOOGLE_CLIENT_ID_IOS=YOUR_GOOGLE_CLIENT_ID_IOS_HERE
