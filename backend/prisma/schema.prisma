// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  owner
  delivery_boy
}

enum BeatStatus {
  draft
  published
  completed
}

enum RiskLevel {
  green
  yellow
  red
}

enum VisitStatus {
  pending
  in_progress
  completed
  skipped
}

enum PaymentMethod {
  cash
  upi
}

enum CreditPromiseStatus {
  pending
  fulfilled
  overdue
}

model Distributor {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  stores Store[]
  skus   SKU[]
  beats  Beat[]

  @@map("distributors")
}

model User {
  id            Int      @id @default(autoincrement())
  distributorId Int
  name          String
  phone         String   @unique
  email         String?
  passwordHash  String
  role          UserRole
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  distributor     Distributor      @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  beatAssignments BeatAssignment[]
  storeVisits     StoreVisit[]
  payments        Payment[]

  @@index([distributorId])
  @@index([role])
  @@map("users")
}

model Store {
  id            Int      @id @default(autoincrement())
  distributorId Int
  name          String
  ownerName     String?
  phone         String?
  address       String?
  latitude      Float?
  longitude     Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  locality           String?
  outstandingBalance Decimal   @default(0) @db.Decimal(10, 2)
  lastVisitedAt      DateTime?
  overdueDays        Int       @default(0)

  distributor      Distributor           @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  assignmentStores BeatAssignmentStore[]
  visits           StoreVisit[]
  ledgerEntries    StoreLedgerEntry[]

  @@index([distributorId])
  @@index([isActive])
  @@map("stores")
}

model SKU {
  id            Int      @id @default(autoincrement())
  distributorId Int
  name          String
  code          String?
  unit          String?
  price         Float
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  distributor   Distributor    @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  deliveryItems DeliveryItem[]
  returnItems   ReturnItem[]

  @@index([distributorId])
  @@index([isActive])
  @@map("skus")
}

model Beat {
  id            Int        @id @default(autoincrement())
  distributorId Int
  date          DateTime
  status        BeatStatus @default(draft)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  distributor Distributor      @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  assignments BeatAssignment[]

  @@unique([distributorId, date])
  @@index([distributorId])
  @@index([date])
}

model BeatAssignment {
  id            Int @id @default(autoincrement())
  beatId        Int
  deliveryBoyId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beat        Beat @relation(fields: [beatId], references: [id], onDelete: Cascade)
  deliveryBoy User @relation(fields: [deliveryBoyId], references: [id], onDelete: Cascade)

  stores BeatAssignmentStore[]

  @@unique([beatId, deliveryBoyId])
  @@index([beatId])
  @@index([deliveryBoyId])
}

model BeatAssignmentStore {
  id               Int @id @default(autoincrement())
  beatAssignmentId Int
  storeId          Int

  visitOrder          Int
  outstandingSnapshot Decimal   @db.Decimal(10, 2)
  overdueDaysSnapshot Int
  riskLevel           RiskLevel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beatAssignment BeatAssignment @relation(fields: [beatAssignmentId], references: [id], onDelete: Cascade)
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  visit StoreVisit?

  @@unique([beatAssignmentId, storeId])
  @@index([beatAssignmentId])
  @@index([storeId])
  @@index([visitOrder])
}

model StoreVisit {
  id                    Int @id @default(autoincrement())
  beatAssignmentStoreId Int
  storeId               Int
  deliveryBoyId         Int

  status VisitStatus @default(pending)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beatAssignmentStore BeatAssignmentStore @relation(fields: [beatAssignmentStoreId], references: [id], onDelete: Cascade)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  deliveryBoy User @relation(fields: [deliveryBoyId], references: [id], onDelete: Cascade)

  deliveryItems DeliveryItem[]
  returnItems   ReturnItem[]
  payments      Payment[]
  creditPromise CreditPromise?
  ledgerEntry   StoreLedgerEntry?

  @@unique([beatAssignmentStoreId])
  @@index([storeId])
  @@index([deliveryBoyId])
  @@index([status])
}

model DeliveryItem {
  id Int @id @default(autoincrement())

  storeVisitId Int
  skuId        Int

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storeVisit StoreVisit @relation(fields: [storeVisitId], references: [id], onDelete: Cascade)

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([storeVisitId])
  @@index([skuId])
}

model ReturnItem {
  id Int @id @default(autoincrement())

  storeVisitId Int
  skuId        Int
  quantity     Int
  reason       String?

  createdAt DateTime @default(now())

  storeVisit StoreVisit @relation(fields: [storeVisitId], references: [id], onDelete: Cascade)

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([storeVisitId])
  @@index([skuId])
}

model Payment {
  id Int @id @default(autoincrement())

  storeVisitId  Int
  deliveryBoyId Int

  method PaymentMethod
  amount Decimal       @db.Decimal(10, 2)

  reference String?

  createdAt DateTime @default(now())

  storeVisit StoreVisit @relation(fields: [storeVisitId], references: [id], onDelete: Cascade)

  deliveryBoy User @relation(fields: [deliveryBoyId], references: [id], onDelete: Cascade)

  @@index([storeVisitId])
  @@index([deliveryBoyId])
  @@index([method])
}

model CreditPromise {
  id Int @id @default(autoincrement())

  storeVisitId Int @unique

  amount       Decimal             @db.Decimal(10, 2)
  promisedDate DateTime
  status       CreditPromiseStatus @default(pending)
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storeVisit StoreVisit @relation(fields: [storeVisitId], references: [id], onDelete: Cascade)
}

model StoreLedgerEntry {
  id Int @id @default(autoincrement())

  storeId      Int
  storeVisitId Int? @unique

  previousBalance Decimal @db.Decimal(10, 2)

  salesAmount   Decimal @default(0) @db.Decimal(10, 2)
  returnAmount  Decimal @default(0) @db.Decimal(10, 2)
  paymentAmount Decimal @default(0) @db.Decimal(10, 2)
  creditAmount  Decimal @default(0) @db.Decimal(10, 2)

  newBalance Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeVisit StoreVisit? @relation(fields: [storeVisitId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([storeVisitId])
  @@index([createdAt])
  @@map("store_ledger_entries")
}
